{% set g = OPNsense.ActiveStandby.general if helpers.exists('OPNsense.ActiveStandby.general') else {} %}
{
  "listen_port": {{ g.listen_port|default("7690") }},
  "ha_device": "{% if g.ha_interface|default("") %}{{ helpers.physical_interface(g.ha_interface) }}{% endif %}",
  "mgmt_device": "{% if g.mgmt_interface|default("") %}{{ helpers.physical_interface(g.mgmt_interface) }}{% endif %}",
  "auto_failover": {{ "true" if g.auto_failover|default("1") == "1" else "false" }},
  "allow_ha_only_promote": {{ "true" if g.allow_ha_only_promote|default("0") == "1" else "false" }},
  "force_promisc": {{ "true" if g.force_promisc|default("0") == "1" else "false" }},
  "notify_level": "{{ g.notify_level|default("warning") }}",
  "notify_webhook": "{{ g.notify_webhook|default("") }}",
  "fence_command": "{{ g.fence_command|default("") }}",
  "preempt": {{ "true" if g.preempt|default("0") == "1" else "false" }},
  "preempt_delay": {{ g.preempt_delay|default("300") }},
  "monitor_interfaces": "{{ g.monitor_interfaces|default("") }}",
  "health_services": {{ "true" if g.health_services|default("0") == "1" else "false" }},
  "detect_time": {{ g.detect_time|default("2") }},
  "mgmt_probe_targets": "{{ g.mgmt_probe_targets|default("") }}",
  "sync_sessions": {{ "true" if g.sync_sessions|default("1") == "1" else "false" }},
  "probe_targets": "{{ g.probe_targets|default("") }}",
  "health_hold": {{ g.health_hold|default("6") }},
  "pair_token": "{{ g.pair_token|default("") }}",
  "pair_expires": "{{ g.pair_expires|default("") }}"
}
