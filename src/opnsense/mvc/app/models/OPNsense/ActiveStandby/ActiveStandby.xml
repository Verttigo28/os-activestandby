<model>
    <mount>//OPNsense/ActiveStandby</mount>
    <version>1.1.0</version>
    <description>Active/standby HA settings (node-local; excluded from config sync)</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <ha_interface type="InterfaceField">
                <Required>N</Required>
                <multiple>N</multiple>
                <AllowDynamic>N</AllowDynamic>
            </ha_interface>
            <mgmt_interface type="InterfaceField">
                <Required>N</Required>
                <multiple>N</multiple>
                <AllowDynamic>N</AllowDynamic>
            </mgmt_interface>
            <auto_failover type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </auto_failover>
            <allow_ha_only_promote type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </allow_ha_only_promote>
            <force_promisc type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </force_promisc>
            <preempt type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </preempt>
            <preempt_delay type="IntegerField">
                <Default>300</Default>
                <MinimumValue>30</MinimumValue>
                <MaximumValue>86400</MaximumValue>
                <Required>Y</Required>
            </preempt_delay>
            <monitor_interfaces type="TextField">
                <Required>N</Required>
                <Mask>/^([a-zA-Z0-9_]+(,[a-zA-Z0-9_]+)*)?$/</Mask>
                <ValidationMessage>Comma separated interface keys, e.g. wan,opt3.</ValidationMessage>
            </monitor_interfaces>
            <health_services type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </health_services>
            <probe_targets type="TextField">
                <Required>N</Required>
                <Mask>/^(([0-9]{1,3}[.]){3}[0-9]{1,3}(,([0-9]{1,3}[.]){3}[0-9]{1,3}){0,4})?$/</Mask>
                <ValidationMessage>Enter up to five IPv4 addresses separated by commas.</ValidationMessage>
            </probe_targets>
            <virtual_mac type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </virtual_mac>
            <detect_time type="IntegerField">
                <Default>2</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>30</MaximumValue>
                <Required>Y</Required>
            </detect_time>
            <health_hold type="IntegerField">
                <Default>6</Default>
                <MinimumValue>3</MinimumValue>
                <MaximumValue>120</MaximumValue>
                <Required>Y</Required>
            </health_hold>
            <pair_token type="TextField">
                <Required>N</Required>
                <Mask>/^([A-Za-z2-7]{5}(-[A-Za-z2-7]{5}){3})?$/</Mask>
            </pair_token>
            <pair_expires type="TextField">
                <Required>N</Required>
            </pair_expires>
            <fence_command type="TextField">
                <Required>N</Required>
                <Mask>/^(\/[A-Za-z0-9_.\/-]{1,200})?$/</Mask>
                <ValidationMessage>Enter an absolute path without spaces.</ValidationMessage>
            </fence_command>
            <notify_level type="OptionField">
                <Default>warning</Default>
                <Required>Y</Required>
                <OptionValues>
                    <info>Everything</info>
                    <warning>Warnings and errors</warning>
                    <error>Errors only</error>
                </OptionValues>
            </notify_level>
            <notify_webhook type="TextField">
                <Required>N</Required>
                <Mask>/^(https?:\/\/[^\s"'&lt;&gt;]{3,500})?$/</Mask>
                <ValidationMessage>Enter an http(s) URL.</ValidationMessage>
            </notify_webhook>
            <listen_port type="IntegerField">
                <Default>7690</Default>
                <MinimumValue>1024</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Required>Y</Required>
            </listen_port>
        </general>
    </items>
</model>
