<model>
    <mount>//OPNsense/ActiveStandby</mount>
    <version>1.1.0</version>
    <description>Active/standby HA settings (shared between the nodes except enabled, HA interface, management interface and peer port)</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <ha_interface type="InterfaceField">
                <Required>N</Required>
                <multiple>N</multiple>
                <AllowDynamic>N</AllowDynamic>
            </ha_interface>
            <mgmt_interface type="InterfaceField">
                <Required>N</Required>
                <multiple>N</multiple>
                <AllowDynamic>N</AllowDynamic>
            </mgmt_interface>
            <auto_failover type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </auto_failover>
            <allow_ha_only_promote type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </allow_ha_only_promote>
            <ha_mode type="OptionField">
                <Default>classic</Default>
                <Required>Y</Required>
                <OptionValues>
                    <classic>Classic standby (interfaces down)</classic>
                    <warm>Warm standby (experimental: interfaces up and silent)</warm>
                    <hot>Hot standby (experimental: interfaces up, silent, already carrying the shared MAC)</hot>
                </OptionValues>
            </ha_mode>
            <hot_lacp type="OptionField">
                <Default>off</Default>
                <Required>Y</Required>
                <OptionValues>
                    <off>LACP LAGG uses the classic takeover (safe with any switch)</off>
                    <shared>LACP LAGG stays up with the shared MAC (fastest: one static port-channel per firewall)</shared>
                </OptionValues>
            </hot_lacp>
            <fast_ifaces type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </fast_ifaces>
            <force_promisc type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </force_promisc>
            <preempt type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </preempt>
            <preempt_delay type="IntegerField">
                <Default>300</Default>
                <MinimumValue>30</MinimumValue>
                <MaximumValue>86400</MaximumValue>
                <Required>Y</Required>
            </preempt_delay>
            <monitor_interfaces type="InterfaceField">
                <Required>N</Required>
                <multiple>Y</multiple>
                <AllowDynamic>N</AllowDynamic>
            </monitor_interfaces>
            <health_services type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </health_services>
            <probe_targets type="TextField">
                <Required>N</Required>
                <Mask>/^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(,((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){0,4})?$/D</Mask>
                <ValidationMessage>Enter up to five IPv4 addresses separated by commas.</ValidationMessage>
            </probe_targets>
            <virtual_mac type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </virtual_mac>
            <sync_sessions type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </sync_sessions>
            <mgmt_probe_targets type="TextField">
                <Required>N</Required>
                <Mask>/^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(,((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){0,4})?$/D</Mask>
                <ValidationMessage>Enter up to five IPv4 addresses separated by commas.</ValidationMessage>
            </mgmt_probe_targets>
            <detect_time type="IntegerField">
                <Default>3</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>30</MaximumValue>
                <Required>Y</Required>
            </detect_time>
            <health_hold type="IntegerField">
                <Default>6</Default>
                <MinimumValue>3</MinimumValue>
                <MaximumValue>120</MaximumValue>
                <Required>Y</Required>
            </health_hold>
            <pair_token type="TextField">
                <Required>N</Required>
                <Mask>/^([A-Za-z2-7]{5}(-[A-Za-z2-7]{5}){3})?$/D</Mask>
            </pair_token>
            <pair_expires type="TextField">
                <Required>N</Required>
                <Mask>/^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$/D</Mask>
            </pair_expires>
            <fence_command type="TextField">
                <Required>N</Required>
                <Mask>/^(\/[A-Za-z0-9_.\/-]{1,200})?$/D</Mask>
                <ValidationMessage>Enter an absolute path without spaces.</ValidationMessage>
            </fence_command>
            <fence_required type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </fence_required>
            <notify_level type="OptionField">
                <Default>warning</Default>
                <Required>Y</Required>
                <OptionValues>
                    <info>Everything</info>
                    <warning>Warnings and errors</warning>
                    <error>Errors only</error>
                </OptionValues>
            </notify_level>
            <notify_webhook type="TextField">
                <Required>N</Required>
                <Mask>/^(https?:\/\/[^\s"'&lt;&gt;\\\x00-\x1f]{3,500})?$/D</Mask>
                <ValidationMessage>Enter an http(s) URL.</ValidationMessage>
            </notify_webhook>
            <listen_port type="IntegerField">
                <Default>7690</Default>
                <MinimumValue>1024</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Required>Y</Required>
            </listen_port>
        </general>
    </items>
</model>
